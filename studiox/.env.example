# Neon Postgres connection string. `npm run db:setup` fills this in for the `dev` branch.
# Leave empty in local development to use the embedded PGlite database in .data/pglite.
DATABASE_URL=

# Cloudinary (Settings > API Keys in the Cloudinary console). Without these, image upload
# in /admin is disabled and the site keeps using the local placeholder images.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Search Console "HTML tag" verification: paste only the content="..." value. Optional;
# not needed if you verify the domain with a DNS record instead.
GOOGLE_SITE_VERIFICATION=

# Contact form email notifications (https://resend.com). Optional: without a key, messages
# still arrive in the admin Inbox. CONTACT_FROM_EMAIL needs a domain verified in Resend;
# without it Resend's test sender is used, which only delivers to the Resend account owner.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
