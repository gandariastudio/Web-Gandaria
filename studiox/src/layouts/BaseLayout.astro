---
import { Font } from 'astro:assets';
import '@/styles/global.css';
import Seo from '@/components/layout/Seo.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Loader from '@/components/layout/Loader.astro';
import Crosshair from '@/components/layout/Crosshair.astro';
import { pageMeta } from '@/utils/seo';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  /** Structured data (schema.org JSON-LD) for this page. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, image, noindex, jsonLd } = Astro.props;
const meta = pageMeta({ title, description, image, noindex, path: Astro.url.pathname });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo meta={meta} jsonLd={jsonLd} />
    <Font cssVariable="--font-geist-face" preload />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      (function () {
        var html = document.documentElement;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return html.classList.add('no-loader');
        html.classList.add('js');
        try {
          if (sessionStorage.getItem('gandaria-loader')) html.classList.add('no-loader');
          var pt = sessionStorage.getItem('gandaria-pt');
          if (pt) {
            html.classList.add('pt-arriving');
            html.dataset.ptLabel = pt;
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <Loader />
    <Header />
    <Crosshair />
    <main id="top">
      <slot />
    </main>
    <Footer />
    <script>
      import '@/scripts/main';
    </script>
  </body>
</html>
