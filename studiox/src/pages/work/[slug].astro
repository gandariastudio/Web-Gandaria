---
import BaseLayout from '@/layouts/BaseLayout.astro';
import NextStep from '@/components/sections/shared/NextStep.astro';
import CmsImage from '@/components/ui/CmsImage.astro';
import ProjectBlocks from '@/components/sections/project/ProjectBlocks.astro';
import { getDb } from '@/lib/db';
import { getProject } from '@/lib/db/queries';
import { CLOUDINARY_CLOUD_NAME } from 'astro:env/server';
import { hasImage, imageSrc } from '@/lib/cms/cloudinary';
import { breadcrumbLd, caseStudyLd } from '@/utils/seo';

/**
 * Old project URLs → their new slug. Used only once the old slug no longer exists and the new one
 * does, so an entry can be added before the slug is renamed in the admin.
 */
const MOVED: Record<string, string> = {
  'urbn-hoops-urbn-hoops-basketball-culture-brand-identity-basketball-culture-brand': 'urbn-hoops-brand-identity',
};

const db = await getDb();
const slug = Astro.params.slug ?? '';
const p = await getProject(db, slug);
if (!p) {
  const to = MOVED[slug];
  if (to && (await getProject(db, to))) return Astro.redirect(`/work/${to}`, 301);
  return Astro.rewrite('/404');
}
const jsonLd = [
  caseStudyLd({ ...p, image: hasImage(p.cover) ? imageSrc(p.cover, CLOUDINARY_CLOUD_NAME, 1600) : undefined }),
  breadcrumbLd([['Work', '/work'], [p.title, `/work/${p.slug}`]]),
];
const facts = [
  ['Client', p.client],
  ['Role', p.role],
  ['Sector', p.sector],
  ['Year', p.year],
];
---

<BaseLayout title={p.title} description={p.summary} jsonLd={jsonLd}>
  <section class="bg-fog px-5 pt-28 pb-12 md:px-8 md:pt-[136px] md:pb-16 lg:px-10 lg:pt-40 lg:pb-20" data-cursor="Scroll">
    <div class="mx-auto flex max-w-[1600px] flex-col gap-10">
      <a href="/work" class="text-link type-small w-max">← All work</a>
      <p class="type-label flex items-center gap-2.5">
        <span class="text-cobalt">{p.sector}</span>
        <span class="text-muted">·</span>
        <span class="text-muted">{p.year}</span>
      </p>
      <h1 class="project-hero-title" data-text-reveal="line" data-tr-blur="8" data-tr-y="28" data-tr-stagger="0.05">{p.title}</h1>
      <p class="type-h4 max-w-[640px] text-muted" data-reveal>{p.summary}</p>
      <dl class="grid auto-rows-fr grid-cols-2 gap-6 line-t pt-6 lg:grid-cols-4" data-reveal data-reveal-delay="0.1">
        {
          facts.map(([term, value]) => (
            <div class="flex flex-col gap-1.5 self-start">
              <dt class="type-label text-muted">{term}</dt>
              <dd class="type-body">{value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="bg-paper pb-20 md:pb-28 lg:pb-[140px]" data-cursor="Case study">
    <div class="relative aspect-[4/3] overflow-clip" data-img-reveal>
      <CmsImage image={p.cover} widths={[828, 1440, 2400]} sizes="100vw" class="absolute inset-0 size-full object-cover" loading="eager" />
    </div>
  </section>

  <ProjectBlocks blocks={p.blocks} />

  <NextStep wide />
</BaseLayout>

<style>
  .project-hero-title {
    font-size: 64px;
    line-height: 0.95;
    letter-spacing: -0.06em;
  }
  @media (width >= 810px) {
    .project-hero-title {
      font-size: 104px;
      line-height: 0.92;
    }
  }
  @media (width >= 1440px) {
    .project-hero-title {
      font-size: 150px;
    }
  }
</style>
