---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/sections/shared/PageHero.astro';
import { privacy } from '@/data/pages';
---

<BaseLayout title="Privacy policy" description={privacy.intro}>
  <PageHero tag={privacy.tag} meta={privacy.meta} lines={privacy.lines} intro={privacy.intro} />

  <section class="bg-fog px-5 pb-24 md:px-8 md:pb-[120px] xl:px-10 xl:pb-40" data-cursor="Privacy">
    <div class="mx-auto flex max-w-[1600px] gap-10">
      <div class="min-h-[100px] flex-1 max-md:hidden" aria-hidden="true"></div>
      <div class="flex max-w-[760px] flex-[2] flex-col gap-10">
        {
          privacy.clauses.map((c, i) => (
            <div class="flex flex-col gap-3" data-reveal data-reveal-delay={i * 0.05}>
              <h2 class="type-h3">{c.title}</h2>
              <p class="type-body text-muted">{c.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
