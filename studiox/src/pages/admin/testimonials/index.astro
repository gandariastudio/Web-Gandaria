---
import AdminLayout from '@/layouts/AdminLayout.astro';
import ListPage from '@/components/admin/ListPage.astro';
import ItemRows from '@/components/admin/ItemRows.astro';
import { getDb } from '@/lib/db';
import { adminListTestimonials } from '@/lib/db/admin';
import { excerpt, handleListPost } from '@/lib/cms/admin-page';

const db = await getDb();
const response = await handleListPost(Astro, db, 'testimonials');
if (response) return response;
const items = (await adminListTestimonials(db)).map((t) => ({
  id: t.id,
  title: t.name,
  meta: `${t.role} · “${excerpt(t.quote, 90)}”`,
  published: t.published,
}));
---

<AdminLayout title="Testimonials">
  <ListPage title="Testimonials" description="Quotes in the card deck on the home page, in this order." newHref="/admin/testimonials/new" newLabel="New testimonial" count={items.length} noun="testimonial" sortable>
    <ItemRows items={items} base="/admin/testimonials" noun="testimonial" sortable />
  </ListPage>
</AdminLayout>
