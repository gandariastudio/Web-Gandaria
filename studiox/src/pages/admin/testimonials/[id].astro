---
import AdminLayout from '@/layouts/AdminLayout.astro';
import EditHeader from '@/components/admin/EditHeader.astro';
import FormCard from '@/components/admin/FormCard.astro';
import Field from '@/components/admin/Field.astro';
import SaveBar from '@/components/admin/SaveBar.astro';
import DangerZone from '@/components/admin/DangerZone.astro';
import { getDb } from '@/lib/db';
import { findById, saveTestimonial } from '@/lib/db/admin';
import { readers, testimonialSchema, validate, type FieldErrors } from '@/lib/cms/validation';
import { parseId, relativeTime, saveErrorMessage } from '@/lib/cms/admin-page';

const id = parseId(Astro.params.id);
if (id === null) return Astro.rewrite('/404');
const db = await getDb();
const row = id === 'new' ? null : await findById(db, 'testimonials', id);
if (id !== 'new' && !row) return Astro.rewrite('/404');

let values: any = row ?? { quote: '', name: '', role: '', published: true };
let errors: FieldErrors = {};

if (Astro.request.method === 'POST') {
  values = readers.testimonial(await Astro.request.formData());
  const result = validate(testimonialSchema, values);
  if (!result.ok) errors = result.errors;
  else {
    try {
      const savedId = await saveTestimonial(db, row?.id ?? null, result.data);
      return Astro.redirect(`/admin/testimonials/${savedId}?saved=1`, 303);
    } catch (error) {
      errors = { _form: saveErrorMessage(error) };
    }
  }
  Astro.response.status = 422;
}
const title = row ? row.name : 'New testimonial';
const self = row ? `/admin/testimonials/${row.id}` : '/admin/testimonials/new';
---

<AdminLayout title={title} width="narrow">
  <EditHeader title={title} subtitle={row ? `Last edited ${relativeTime(row.updatedAt)}` : 'Add a quote from a client.'} back={{ href: '/admin/testimonials', label: 'Testimonials' }} errors={errors} />

  <form method="post" class="a-form" data-edit-form data-start-dirty={String(Astro.request.method === 'POST')}>
    <FormCard title="Quote" description="Shown in the card deck on the home page.">
      <Field name="quote" type="textarea" rows={4} label="What they said" value={values.quote} error={errors.quote} required hint="Without quotation marks. The cards add them." />
      <div class="a-fields">
        <Field name="name" label="Name" value={values.name} error={errors.name} required />
        <Field name="role" label="Role and company" value={values.role} error={errors.role} required placeholder="Marketing Director, Rasakota" />
      </div>
    </FormCard>

    <SaveBar published={values.published} saveLabel={row ? 'Save changes' : 'Create testimonial'} isNew={!row} resetHref={self} />
  </form>

  {row && <DangerZone action="/admin/testimonials" id={row.id} noun="testimonial" />}
</AdminLayout>
