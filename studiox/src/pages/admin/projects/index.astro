---
import AdminLayout from '@/layouts/AdminLayout.astro';
import ListPage from '@/components/admin/ListPage.astro';
import ItemGrid from '@/components/admin/ItemGrid.astro';
import { getDb } from '@/lib/db';
import { adminListProjects } from '@/lib/db/admin';
import { handleListPost, thumb } from '@/lib/cms/admin-page';

const db = await getDb();
const response = await handleListPost(Astro, db, 'projects');
if (response) return response;
const items = (await adminListProjects(db)).map((p) => ({
  id: p.id,
  title: p.title,
  kicker: `${p.sector} · ${p.year}`,
  meta: p.services,
  published: p.published,
  image: thumb(p.cover),
  viewHref: p.published ? `/work/${p.slug}` : undefined,
}));
---

<AdminLayout title="Projects">
  <ListPage title="Projects" description="Case studies shown on the home page and on /work, in this order." newHref="/admin/projects/new" newLabel="New project" count={items.length} noun="project" sortable>
    <ItemGrid items={items} base="/admin/projects" noun="project" sortable />
  </ListPage>
</AdminLayout>
