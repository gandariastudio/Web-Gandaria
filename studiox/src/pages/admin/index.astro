---
/*
 * Dashboard, styled like the public website (trial for restyling the admin): website type scale,
 * tags, hairlines, sharp corners, .btn buttons and an orange band for new messages. The rest of
 * the admin still uses the a-* styles in AdminLayout.astro.
 */
import AdminLayout from '@/layouts/AdminLayout.astro';
import { getDb } from '@/lib/db';
import { counts, recentlyEdited } from '@/lib/db/admin';
import { getSettings } from '@/lib/db/queries';
import { unreadEnquiries } from '@/lib/db/enquiries';
import { relativeTime, thumb } from '@/lib/cms/admin-page';

const db = await getDb();
const [n, recent, settings, unread] = await Promise.all([counts(db), recentlyEdited(db, 6), getSettings(db), unreadEnquiries(db)]);
const stats: { label: string; href: string; count: number }[] = [
  { label: 'Projects', href: '/admin/projects', count: n.projects },
  { label: 'Articles', href: '/admin/journal', count: n.posts },
  { label: 'Services', href: '/admin/services', count: n.services },
  { label: 'Testimonials', href: '/admin/testimonials', count: n.testimonials },
  { label: 'Clients', href: '/admin/clients', count: n.clients },
  { label: 'Questions', href: '/admin/faqs', count: n.faqs },
];
const today = new Date().toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Asia/Jakarta' });
const pad = (i: number) => String(i + 1).padStart(2, '0');
const socials = settings.socialLinks.map((l) => l.label).join(', ') || 'None yet';
---

<AdminLayout title="Dashboard">
  <div class="dash flex flex-col gap-10 md:gap-12">
    <header class="flex flex-col gap-5">
      <div class="flex items-center justify-between gap-6 line-b pb-4">
        <p class="tag">Dashboard</p>
        <p class="type-label text-muted">{today}</p>
      </div>
      <h1 class="type-h2">Welcome back.</h1>
      <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <p class="type-small max-w-[420px] text-muted">Edit what visitors see on gandariastudio.com. Saved changes appear on the site within a minute.</p>
        <div class="flex flex-wrap gap-3">
          <a class="btn btn-secondary dash-btn" href="/admin/journal/new">New article</a>
          <a class="btn btn-cobalt dash-btn" href="/admin/projects/new">New project</a>
        </div>
      </div>
    </header>

    {
      unread > 0 && (
        <a href="/admin/inbox" class="dash-inbox line-y">
          <span class="dash-inbox-dot" aria-hidden="true" />
          <span class="type-small">
            {unread} new {unread === 1 ? 'message' : 'messages'} from the contact form
          </span>
          <span class="dash-inbox-cta type-small">Open inbox →</span>
        </a>
      )
    }

    <section class="flex flex-col gap-4" aria-labelledby="dash-content">
      <p id="dash-content" class="tag">Content</p>
      <div class="dash-stats">
        {
          stats.map((s, i) => (
            <a href={s.href} class="dash-stat">
              <span class="type-label flex items-baseline justify-between gap-4">
                <span class="tabular-nums">({pad(i)})</span>
                <span class="dash-arrow" aria-hidden="true">
                  →
                </span>
              </span>
              <span class="dash-count tabular-nums">{s.count}</span>
              <span class="type-small text-muted">{s.label}</span>
            </a>
          ))
        }
      </div>
    </section>

    <div class="flex flex-col gap-10 md:gap-12 xl:flex-row xl:gap-16">
      <section class="flex flex-col gap-4 xl:flex-[1.4]" aria-labelledby="dash-recent">
        <p id="dash-recent" class="tag">Recently edited</p>
        {
          recent.length === 0 ? (
            <p class="type-body line-t pt-5 text-muted">Nothing edited yet.</p>
          ) : (
            <ul class="flex flex-col">
              {recent.map((r) => (
                <li>
                  <a href={r.href} class="dash-row line-t">
                    <span class="dash-thumb">{r.image ? <img src={thumb(r.image, 160)} alt="" loading="lazy" /> : <span class="type-label">{r.kind.slice(0, 1)}</span>}</span>
                    <span class="flex min-w-0 flex-1 flex-col gap-1">
                      <span class="type-body truncate">{r.title}</span>
                      <span class="type-label text-muted">
                        {r.kind} · {relativeTime(r.updatedAt)}
                      </span>
                    </span>
                    <span class="dash-arrow type-body" aria-hidden="true">
                      →
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </section>

      <section class="flex flex-col gap-4 xl:flex-1" aria-labelledby="dash-site">
        <p id="dash-site" class="tag">Site details</p>
        <div class="flex flex-col gap-2.5 line-t pt-5">
          <p class="type-label text-muted">Contact email</p>
          <p class="type-body">{settings.email}</p>
        </div>
        <div class="flex flex-col gap-2.5 line-t pt-5">
          <p class="type-label text-muted">Booking new projects from</p>
          <p class="type-body">{settings.bookingFrom}</p>
        </div>
        <div class="flex flex-col gap-2.5 line-t pt-5">
          <p class="type-label text-muted">Social links</p>
          <p class="type-body">{socials}</p>
        </div>
        <a class="dash-link type-small w-max" href="/admin/settings">Edit site details →</a>
      </section>
    </div>
  </div>
</AdminLayout>

<style>
  .dash {
    padding-bottom: 40px;
  }
  /* Smaller than the website's 51px buttons, to keep the admin quiet. */
  .dash-btn {
    height: 42px;
    padding: 0 20px;
    font-size: 14px;
  }

  /* New messages: one quiet line between hairlines, with the website's small orange square. */
  .dash-inbox {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: -20px;
    padding: 14px 0;
    color: var(--color-ink);
  }
  .dash-inbox-dot {
    width: 7px;
    height: 7px;
    flex: none;
    background: var(--color-cobalt);
  }
  .dash-inbox-cta {
    margin-left: auto;
    color: var(--color-cobalt);
    white-space: nowrap;
  }
  .dash-inbox:hover .dash-inbox-cta {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /*
   * Counts: a full hairline grid. The container draws the outer top and left edges and every cell
   * draws its own right and bottom edge, so all lines show whatever the number of columns.
   */
  .dash-stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    box-shadow:
      inset 1px 0 0 var(--color-line),
      inset 0 1px 0 var(--color-line);
  }
  @media (min-width: 810px) {
    .dash-stats {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 1440px) {
    .dash-stats {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }
  .dash-stat {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 14px 16px 18px;
    box-shadow:
      inset -1px 0 0 var(--color-line),
      inset 0 -1px 0 var(--color-line);
    color: var(--color-ink);
  }
  @media (min-width: 810px) {
    .dash-stat {
      padding: 16px 18px 20px;
    }
  }
  .dash-count {
    font-size: 40px;
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .dash-stat:hover .dash-count {
    color: var(--color-cobalt);
  }

  .dash-arrow {
    visibility: hidden;
  }
  .dash-stat:hover .dash-arrow,
  .dash-row:hover .dash-arrow {
    visibility: visible;
    color: var(--color-cobalt);
  }
  .dash-row:hover .truncate {
    color: var(--color-cobalt);
  }

  /* Recently edited: website list rows with a square thumbnail. */
  .dash-row {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 0;
    color: var(--color-ink);
  }
  .dash-link {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .dash-link:hover {
    color: var(--color-cobalt);
  }
  .dash-thumb {
    display: grid;
    place-items: center;
    flex: none;
    width: 48px;
    height: 36px;
    overflow: hidden;
    background: var(--color-fog);
    color: var(--color-muted);
  }
  .dash-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
