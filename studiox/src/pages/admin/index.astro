---
import AdminLayout from '@/layouts/AdminLayout.astro';
import Icon, { type IconName } from '@/components/admin/Icon.astro';
import { getDb } from '@/lib/db';
import { counts, recentlyEdited } from '@/lib/db/admin';
import { getSettings } from '@/lib/db/queries';
import { unreadEnquiries } from '@/lib/db/enquiries';
import { relativeTime, thumb } from '@/lib/cms/admin-page';

const db = await getDb();
const [n, recent, settings, unread] = await Promise.all([counts(db), recentlyEdited(db, 6), getSettings(db), unreadEnquiries(db)]);
const tiles: { label: string; href: string; count: number; icon: IconName }[] = [
  { label: 'Projects', href: '/admin/projects', count: n.projects, icon: 'projects' },
  { label: 'Articles', href: '/admin/journal', count: n.posts, icon: 'journal' },
  { label: 'Services', href: '/admin/services', count: n.services, icon: 'services' },
  { label: 'Testimonials', href: '/admin/testimonials', count: n.testimonials, icon: 'testimonials' },
  { label: 'Clients', href: '/admin/clients', count: n.clients, icon: 'clients' },
  { label: 'Questions', href: '/admin/faqs', count: n.faqs, icon: 'faq' },
];
const kindIcon: Record<string, IconName> = { Project: 'projects', Article: 'journal', Service: 'services', Testimonial: 'testimonials', Client: 'clients', FAQ: 'faq' };
---

<AdminLayout title="Dashboard">
  <header class="a-head">
    <div>
      <h1 class="a-title">Welcome back</h1>
      <p class="a-sub">Edit what visitors see on gandariastudio.com. Saved changes appear on the site within a minute.</p>
    </div>
    <div class="a-actions">
      <a class="a-btn a-btn--ghost" href="/admin/journal/new"><Icon name="plus" size={16} />New article</a>
      <a class="a-btn" href="/admin/projects/new"><Icon name="plus" size={16} />New project</a>
    </div>
  </header>

  {
    unread > 0 && (
      <a class="a-inbox-note" href="/admin/inbox">
        <Icon name="inbox" size={18} />
        <span>
          You have <strong>{unread} new {unread === 1 ? 'message' : 'messages'}</strong> from the contact form.
        </span>
        <span class="a-inbox-open">Open inbox →</span>
      </a>
    )
  }

  <div class="a-tiles">
    {
      tiles.map((t) => (
        <a href={t.href} class="a-tile">
          <span class="a-tile-icon">
            <Icon name={t.icon} size={17} />
          </span>
          <span>
            <span class="a-tile-count block">{t.count}</span>
            <span class="a-tile-label block">{t.label}</span>
          </span>
        </a>
      ))
    }
  </div>

  <h2 class="a-section-title">Recently edited</h2>
  <section class="a-card a-card--list">
    {
      recent.length === 0 ? (
        <p class="a-hint">Nothing edited yet.</p>
      ) : (
        recent.map((r) => (
          <a href={r.href} class="a-recent">
            {r.image ? (
              <span class="a-thumb">
                <img src={thumb(r.image, 120)} alt="" loading="lazy" />
              </span>
            ) : (
              <span class="a-thumb is-icon">
                <Icon name={kindIcon[r.kind] ?? 'edit'} size={18} />
              </span>
            )}
            <span class="a-row-main">
              <span class="a-row-title-plain">{r.title}</span>
              <span class="a-row-meta">
                {r.kind} · {relativeTime(r.updatedAt)}
              </span>
            </span>
            <Icon name="edit" size={16} class="a-faint" />
          </a>
        ))
      )
    }
  </section>

  <h2 class="a-section-title">Site details</h2>
  <section class="a-card">
    <dl class="a-dl">
      <dt>Contact email</dt>
      <dd>{settings.email}</dd>
      <dt>Booking from</dt>
      <dd>{settings.bookingFrom}</dd>
      <dt>Social links</dt>
      <dd>{settings.socialLinks.map((l) => l.label).join(', ') || 'None yet'}</dd>
    </dl>
    <a class="a-btn a-btn--ghost a-btn--sm w-max" href="/admin/settings"><Icon name="settings" size={15} />Edit site details</a>
  </section>
</AdminLayout>

<style>
  .a-inbox-note {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
    padding: 14px 18px;
    border-radius: 16px;
    background: #fff3ec;
    color: #9a3412;
    font-size: 14px;
  }
  .a-inbox-open {
    margin-left: auto;
    font-weight: 600;
    white-space: nowrap;
  }
</style>
