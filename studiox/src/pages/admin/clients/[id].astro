---
import AdminLayout from '@/layouts/AdminLayout.astro';
import EditHeader from '@/components/admin/EditHeader.astro';
import Field from '@/components/admin/Field.astro';
import ImageField from '@/components/admin/ImageField.astro';
import { getDb } from '@/lib/db';
import { findById, saveClient } from '@/lib/db/admin';
import { clientSchema, readers, validate, type FieldErrors } from '@/lib/cms/validation';
import { parseId, saveErrorMessage } from '@/lib/cms/admin-page';

const id = parseId(Astro.params.id);
if (id === null) return Astro.rewrite('/404');
const db = await getDb();
const row = id === 'new' ? null : await findById(db, 'clients', id);
if (id !== 'new' && !row) return Astro.rewrite('/404');

let values: any = row ?? { name: '', logo: null, displayWidth: 80, displayHeight: 80 };
let errors: FieldErrors = {};

if (Astro.request.method === 'POST') {
  values = readers.client(await Astro.request.formData());
  const result = validate(clientSchema, values);
  if (!result.ok) errors = result.errors;
  else {
    try {
      const savedId = await saveClient(db, row?.id ?? null, result.data);
      return Astro.redirect(`/admin/clients/${savedId}?saved=1`, 303);
    } catch (error) {
      errors = { _form: saveErrorMessage(error) };
    }
  }
  Astro.response.status = 422;
}
const title = row?.name ?? 'New client';
---

<AdminLayout title={title}>
  <EditHeader title={title} back={{ href: '/admin/clients', label: 'Clients' }} errors={errors} />

  <form method="post" class="flex flex-col gap-5" data-edit-form>
    <section class="a-card">
      <h2>Client</h2>
      <Field name="name" label="Name" value={values.name} error={errors.name} required hint="Used as the logo's accessible label." />
      <ImageField name="logo" label="Logo" value={values.logo} folder="clients" errors={errors} hint="PNG or SVG on a transparent background. The site shows it as a single-colour shape, so colours in the file are ignored." />
      <div class="a-grid">
        <Field name="displayWidth" type="number" label="Display width (px)" value={values.displayWidth} error={errors.displayWidth} required hint="Size on the logo wall, 16–400." />
        <Field name="displayHeight" type="number" label="Display height (px)" value={values.displayHeight} error={errors.displayHeight} required hint="Keep the logo's own proportions." />
      </div>
    </section>
    <div class="a-savebar">
      <span class="a-hint">{row ? `Last saved ${row.updatedAt.toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' })}` : 'Not saved yet'}</span>
      <button type="submit" class="a-btn">{row ? 'Save changes' : 'Create client'}</button>
    </div>
  </form>
</AdminLayout>
