---
import AdminLayout from '@/layouts/AdminLayout.astro';
import ListPage from '@/components/admin/ListPage.astro';
import ItemGrid from '@/components/admin/ItemGrid.astro';
import { getDb } from '@/lib/db';
import { adminListClients } from '@/lib/db/admin';
import { handleListPost, thumb } from '@/lib/cms/admin-page';

const db = await getDb();
const response = await handleListPost(Astro, db, 'clients');
if (response) return response;
const items = (await adminListClients(db)).map((c) => ({
  id: c.id,
  title: c.name,
  meta: `Shown at ${c.displayWidth} × ${c.displayHeight}px`,
  image: thumb(c.logo, 320),
}));
---

<AdminLayout title="Clients">
  <ListPage title="Clients" description="Logos on the home page and /about, in this order." newHref="/admin/clients/new" newLabel="New client" count={items.length} noun="client" sortable>
    <ItemGrid items={items} base="/admin/clients" noun="client" sortable contain />
  </ListPage>
</AdminLayout>
