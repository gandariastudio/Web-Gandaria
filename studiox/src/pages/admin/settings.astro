---
import AdminLayout from '@/layouts/AdminLayout.astro';
import EditHeader from '@/components/admin/EditHeader.astro';
import FormCard from '@/components/admin/FormCard.astro';
import Field from '@/components/admin/Field.astro';
import SaveBar from '@/components/admin/SaveBar.astro';
import { getDb } from '@/lib/db';
import { saveSettings } from '@/lib/db/admin';
import { getSettings } from '@/lib/db/queries';
import { readers, settingsSchema, validate, type FieldErrors } from '@/lib/cms/validation';
import { saveErrorMessage } from '@/lib/cms/admin-page';

const db = await getDb();
let values: any = await getSettings(db);
let errors: FieldErrors = {};

if (Astro.request.method === 'POST') {
  values = readers.settings(await Astro.request.formData());
  const result = validate(settingsSchema, values);
  if (!result.ok) errors = result.errors;
  else {
    try {
      await saveSettings(db, result.data);
      return Astro.redirect('/admin/settings?saved=1', 303);
    } catch (error) {
      errors = { _form: saveErrorMessage(error) };
    }
  }
  Astro.response.status = 422;
}
const links = [...values.socialLinks, ...Array(6).fill({ label: '', href: '' })].slice(0, 6);
---

<AdminLayout title="Settings" width="narrow">
  <EditHeader title="Site details" subtitle="Used on every page of the website." back={{ href: '/admin', label: 'Dashboard' }} errors={errors} />

  <form method="post" class="a-form" data-edit-form data-start-dirty={String(Astro.request.method === 'POST')}>
    <FormCard title="Contact" description="Where enquiries go and when you are taking on new work.">
      <Field name="email" type="email" label="Studio email" value={values.email} error={errors.email} required hint="Menu, footer, contact page, FAQ and the contact form." />
      <Field name="bookingFrom" label="Booking new projects from" value={values.bookingFrom} error={errors.bookingFrom} required hint="Fills “booking Q1 2027” in the hero, the Work section and the footer." />
    </FormCard>

    <FormCard title="Social links" description="Footer and contact page. Leave a row empty to hide it.">
      {
        links.map((link, i) => (
          <div class="a-fields">
            <Field name={`social.${i}.label`} label={`Name ${i + 1}`} value={link.label} error={errors[`socialLinks.${i}.label`]} placeholder="Instagram" />
            <Field name={`social.${i}.href`} type="url" label="Link" value={link.href} error={errors[`socialLinks.${i}.href`]} placeholder="https://instagram.com/gandariastudio" />
          </div>
        ))
      }
    </FormCard>

    <SaveBar saveLabel="Save details" isNew={false} resetHref="/admin/settings" />
  </form>
</AdminLayout>
