---
import AdminLayout from '@/layouts/AdminLayout.astro';
import EditHeader from '@/components/admin/EditHeader.astro';
import FormCard from '@/components/admin/FormCard.astro';
import Field from '@/components/admin/Field.astro';
import ImageField from '@/components/admin/ImageField.astro';
import SaveBar from '@/components/admin/SaveBar.astro';
import DangerZone from '@/components/admin/DangerZone.astro';
import { getDb } from '@/lib/db';
import { findById, saveService, slugTaken } from '@/lib/db/admin';
import { readers, serviceSchema, validate, type FieldErrors } from '@/lib/cms/validation';
import { parseId, relativeTime, saveErrorMessage } from '@/lib/cms/admin-page';

const id = parseId(Astro.params.id);
if (id === null) return Astro.rewrite('/404');
const db = await getDb();
const row = id === 'new' ? null : await findById(db, 'services', id);
if (id !== 'new' && !row) return Astro.rewrite('/404');

let values: any = row ?? { slug: '', title: '', summary: '', deliverables: '', image: null };
let errors: FieldErrors = {};

if (Astro.request.method === 'POST') {
  values = readers.service(await Astro.request.formData());
  const result = validate(serviceSchema, values);
  if (!result.ok) errors = result.errors;
  else if (await slugTaken(db, 'services', result.data.slug, row?.id)) errors = { slug: 'Another service already uses this ID' };
  else {
    try {
      const savedId = await saveService(db, row?.id ?? null, result.data);
      return Astro.redirect(`/admin/services/${savedId}?saved=1`, 303);
    } catch (error) {
      errors = { _form: saveErrorMessage(error) };
    }
  }
  Astro.response.status = 422;
}
const title = row?.title ?? 'New service';
const self = row ? `/admin/services/${row.id}` : '/admin/services/new';
---

<AdminLayout title={title} width="narrow">
  <EditHeader title={title} subtitle={row ? `Last edited ${relativeTime(row.updatedAt)}` : 'Describe the service and add an image.'} back={{ href: '/admin/services', label: 'Services' }} viewHref={row ? '/services' : undefined} errors={errors} />

  <form method="post" class="a-form" data-edit-form data-start-dirty={String(Astro.request.method === 'POST')}>
    <FormCard title="Service">
      <Field name="title" label="Name" value={values.title} error={errors.title} required attrs={{ 'data-slug-source': true }} />
      <Field name="summary" type="textarea" rows={2} label="Summary" value={values.summary} error={errors.summary} required />
      <Field name="deliverables" label="What you deliver" value={values.deliverables} error={errors.deliverables} required hint="Separate with ·  for example: Logo · Type · Colour · Guidelines" />
    </FormCard>

    <FormCard title="Image" description="Also used as the hover preview on the home page.">
      <ImageField name="image" label="Service image" value={values.image} folder="services" errors={errors} recommended="1600 × 1200 (4:3)" />
    </FormCard>

    <FormCard title="Internal ID">
      <Field name="slug" label="ID" value={values.slug} error={errors.slug} required hint="Not shown to visitors. Filled in from the name." attrs={{ 'data-slug-target': true, 'data-autoslug': String(!row) }} />
    </FormCard>

    <SaveBar saveLabel={row ? 'Save changes' : 'Create service'} isNew={!row} resetHref={self} />
  </form>

  {row && <DangerZone action="/admin/services" id={row.id} noun="service" />}
</AdminLayout>
