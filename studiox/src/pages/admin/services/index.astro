---
import AdminLayout from '@/layouts/AdminLayout.astro';
import ListPage from '@/components/admin/ListPage.astro';
import ItemGrid from '@/components/admin/ItemGrid.astro';
import { getDb } from '@/lib/db';
import { adminListServices } from '@/lib/db/admin';
import { handleListPost, thumb } from '@/lib/cms/admin-page';

const db = await getDb();
const response = await handleListPost(Astro, db, 'services');
if (response) return response;
const items = (await adminListServices(db)).map((s) => ({
  id: s.id,
  title: s.title,
  meta: s.deliverables,
  image: thumb(s.image),
  viewHref: '/services',
}));
---

<AdminLayout title="Services">
  <ListPage title="Services" description="Shown on the home page and on /services, in this order." newHref="/admin/services/new" newLabel="New service" count={items.length} noun="service" sortable>
    <ItemGrid items={items} base="/admin/services" noun="service" sortable />
  </ListPage>
</AdminLayout>
