---
import AdminLayout from '@/layouts/AdminLayout.astro';
import EditHeader from '@/components/admin/EditHeader.astro';
import Field from '@/components/admin/Field.astro';
import Checkbox from '@/components/admin/Checkbox.astro';
import ImageField from '@/components/admin/ImageField.astro';
import RichTextField from '@/components/admin/RichTextField.astro';
import { getDb } from '@/lib/db';
import { findById, savePost, slugTaken } from '@/lib/db/admin';
import { postSchema, readers, validate, type FieldErrors } from '@/lib/cms/validation';
import { parseId, saveErrorMessage, toDateInput } from '@/lib/cms/admin-page';
import { readTime } from '@/lib/cms/read-time';

const id = parseId(Astro.params.id);
if (id === null) return Astro.rewrite('/404');
const db = await getDb();
const row = id === 'new' ? null : await findById(db, 'posts', id);
if (id !== 'new' && !row) return Astro.rewrite('/404');

const blank = { slug: '', title: '', category: '', publishedAt: new Date(), excerpt: '', cover: null, bodyHtml: '', published: false };
let values: any = row ?? blank;
let errors: FieldErrors = {};

if (Astro.request.method === 'POST') {
  values = readers.post(await Astro.request.formData());
  const result = validate(postSchema, values);
  if (!result.ok) errors = result.errors;
  else if (await slugTaken(db, 'posts', result.data.slug, row?.id)) errors = { slug: 'Another article already uses this slug' };
  else {
    try {
      const savedId = await savePost(db, row?.id ?? null, result.data);
      return Astro.redirect(`/admin/journal/${savedId}?saved=1`, 303);
    } catch (error) {
      errors = { _form: saveErrorMessage(error) };
    }
  }
  Astro.response.status = 422;
}
const title = row?.title ?? 'New article';
---

<AdminLayout title={title}>
  <EditHeader title={title} back={{ href: '/admin/journal', label: 'Journal' }} viewHref={row?.published ? `/journal/${row.slug}` : undefined} errors={errors} />

  <form method="post" class="flex flex-col gap-5" data-edit-form>
    <section class="a-card">
      <h2>Basics</h2>
      <div class="a-grid">
        <Field name="title" label="Title" value={values.title} error={errors.title} required attrs={{ 'data-slug-source': true }} />
        <Field name="slug" label="Slug" value={values.slug} error={errors.slug} required hint={row ? 'Changing it changes the page address.' : 'Page address: /journal/slug'} attrs={{ 'data-slug-target': true, 'data-autoslug': String(!row) }} />
        <Field name="category" label="Category" value={values.category} error={errors.category} required placeholder="Brand" />
        <Field name="publishedAt" type="date" label="Publish date" value={toDateInput(values.publishedAt)} error={errors.publishedAt} required />
      </div>
      <Field name="excerpt" type="textarea" rows={2} label="Excerpt" value={values.excerpt} error={errors.excerpt} required hint="Shown on cards and under the title." />
      <Checkbox name="published" label="Published" checked={values.published} hint="Drafts are hidden from the public site." />
    </section>

    <section class="a-card">
      <h2>Cover</h2>
      <ImageField name="cover" label="Cover image" value={values.cover} folder="journal" errors={errors} hint="Recommended 2400 × 1350 (16:9)." />
    </section>

    <section class="a-card">
      <h2>Article</h2>
      <RichTextField name="bodyHtml" label="Body" value={values.bodyHtml} error={errors.bodyHtml} />
      {row && <p class="a-hint">{readTime(row.bodyHtml)}, worked out from the saved text.</p>}
    </section>

    <div class="a-savebar">
      <span class="a-hint">{row ? `Last saved ${row.updatedAt.toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' })}` : 'Not saved yet'}</span>
      <button type="submit" class="a-btn">{row ? 'Save changes' : 'Create article'}</button>
    </div>
  </form>
</AdminLayout>
