---
import AdminLayout from '@/layouts/AdminLayout.astro';
import EditHeader from '@/components/admin/EditHeader.astro';
import FormCard from '@/components/admin/FormCard.astro';
import Field from '@/components/admin/Field.astro';
import SaveBar from '@/components/admin/SaveBar.astro';
import DangerZone from '@/components/admin/DangerZone.astro';
import { getDb } from '@/lib/db';
import { findById, saveFaq } from '@/lib/db/admin';
import { faqSchema, readers, validate, type FieldErrors } from '@/lib/cms/validation';
import { parseId, relativeTime, saveErrorMessage } from '@/lib/cms/admin-page';

const id = parseId(Astro.params.id);
if (id === null) return Astro.rewrite('/404');
const db = await getDb();
const row = id === 'new' ? null : await findById(db, 'faqs', id);
if (id !== 'new' && !row) return Astro.rewrite('/404');

let values: any = row ?? { question: '', answer: '' };
let errors: FieldErrors = {};

if (Astro.request.method === 'POST') {
  values = readers.faq(await Astro.request.formData());
  const result = validate(faqSchema, values);
  if (!result.ok) errors = result.errors;
  else {
    try {
      const savedId = await saveFaq(db, row?.id ?? null, result.data);
      return Astro.redirect(`/admin/faqs/${savedId}?saved=1`, 303);
    } catch (error) {
      errors = { _form: saveErrorMessage(error) };
    }
  }
  Astro.response.status = 422;
}
const title = row?.question ?? 'New question';
const self = row ? `/admin/faqs/${row.id}` : '/admin/faqs/new';
---

<AdminLayout title={title} width="narrow">
  <EditHeader title={title} subtitle={row ? `Last edited ${relativeTime(row.updatedAt)}` : 'Add a question visitors often ask.'} back={{ href: '/admin/faqs', label: 'FAQ' }} errors={errors} />

  <form method="post" class="a-form" data-edit-form data-start-dirty={String(Astro.request.method === 'POST')}>
    <FormCard title="Question and answer" description="Shown on the home page and /services.">
      <Field name="question" label="Question" value={values.question} error={errors.question} required />
      <Field name="answer" type="textarea" rows={5} label="Answer" value={values.answer} error={errors.answer} required />
    </FormCard>

    <SaveBar saveLabel={row ? 'Save changes' : 'Create question'} isNew={!row} resetHref={self} />
  </form>

  {row && <DangerZone action="/admin/faqs" id={row.id} noun="question" />}
</AdminLayout>
