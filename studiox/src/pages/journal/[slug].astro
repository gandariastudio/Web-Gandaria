---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CmsImage from '@/components/ui/CmsImage.astro';
import { getDb } from '@/lib/db';
import { getPost } from '@/lib/db/queries';
import { CLOUDINARY_CLOUD_NAME } from 'astro:env/server';
import { imageSrc } from '@/lib/cms/cloudinary';
import { articleLd } from '@/utils/seo';

const p = await getPost(await getDb(), Astro.params.slug ?? '');
if (!p) return Astro.rewrite('/404');
const ld = articleLd({ ...p, image: imageSrc(p.cover, CLOUDINARY_CLOUD_NAME, 1200) });
const date = p.publishedAt.toLocaleString('en-US', { dateStyle: 'medium', timeZone: 'UTC' });
---

<BaseLayout title={p.title} description={p.excerpt} jsonLd={ld}>
  <article class="bg-fog px-5 pt-[104px] pb-24 md:px-8 md:pt-32 md:pb-[120px] xl:px-10 xl:py-40" data-cursor="Read">
    <div class="mx-auto flex max-w-[1600px] flex-col gap-14">
      <a href="/journal" class="text-link type-small w-max">← All notes</a>
      <header class="flex flex-col gap-6 line-t pt-7">
        <p class="type-label flex flex-wrap items-center gap-2.5">
          <span class="text-cobalt">{p.category}</span>
          <span class="text-muted">·</span>
          <time class="text-muted" datetime={p.publishedAt.toISOString()}>{date}</time>
          <span class="text-muted">·</span>
          <span class="text-muted">{p.readTime}</span>
        </p>
        <h1 class="type-h1 max-w-[1040px]" data-text-reveal="line" data-tr-blur="10" data-tr-y="28" data-tr-stagger="0.05">{p.title}</h1>
        <p class="type-h4 max-w-[640px] text-muted" data-reveal>{p.excerpt}</p>
      </header>
      <div class="relative h-[260px] overflow-clip md:h-[440px] xl:h-[640px]" data-img-reveal>
        <CmsImage image={p.cover} widths={[828, 1440, 2400]} sizes="100vw" class="absolute inset-0 size-full object-cover" loading="eager" />
      </div>
      <div class="flex flex-col gap-7 md:gap-8 xl:flex-row xl:gap-10">
        <aside class="flex flex-col gap-2 xl:flex-1">
          <p class="tag">Gandaria Journal</p>
          <p class="type-small max-w-[260px] text-muted">Written by the Gandaria Studio team in Semarang.</p>
        </aside>
        <div class="article-body xl:max-w-[760px] xl:flex-[2]" data-reveal>
          <Fragment set:html={p.bodyHtml} />
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
