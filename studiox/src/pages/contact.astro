---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/sections/shared/PageHero.astro';
import ContactForm from '@/components/ui/ContactForm.astro';
import LiveClock from '@/components/ui/LiveClock.astro';

const intro = 'Tell us about the project, the timing and what success looks like. A senior member of the team will reply within one business day.';
const { email: EMAIL, socialLinks: elsewhere } = Astro.locals.settings;
---

<BaseLayout title="Contact" description={intro}>
  <PageHero tag="Contact" meta="(Reply within 1 business day)" lines={['Let’s make', 'something.']} intro={intro} />

  <section class="bg-fog px-5 pb-24 md:px-8 md:pb-[120px] xl:px-10 xl:pb-40" data-cursor="Say hello">
    <div class="mx-auto flex max-w-[1600px] flex-col gap-12 md:gap-16 xl:flex-row xl:gap-24">
      <div class="flex flex-col gap-10 xl:flex-1" data-reveal>
        <div class="flex flex-col gap-2.5 line-t pt-5">
          <p class="type-label text-muted">New projects</p>
          <a href={`mailto:${EMAIL}`} class="text-link type-h3 w-max">{EMAIL}</a>
        </div>
        <div class="flex flex-col gap-2.5 line-t pt-5">
          <p class="type-label text-muted">Studio</p>
          <p class="type-body">Semarang, Central Java, Indonesia</p>
        </div>
        <div class="flex flex-col gap-2.5 line-t pt-5">
          <p class="type-label text-muted">Local time</p>
          <LiveClock dot="var(--color-cobalt)" class="text-[17px] leading-[1.3] text-ink" />
          <p class="type-small text-muted">Mon–Fri, 9:00–18:00 WIB</p>
        </div>
        <div class="flex flex-col gap-2.5 line-t pt-5">
          <p class="type-label text-muted">Elsewhere</p>
          <div class="flex items-center gap-5">
            {
              elsewhere.map((l) => (
                <a href={l.href} target="_blank" rel="noopener" class="text-link type-small">
                  {l.label} ↗
                </a>
              ))
            }
          </div>
        </div>
      </div>
      <div class="xl:flex-[1.4]" data-reveal data-reveal-delay="0.1">
        <ContactForm />
      </div>
    </div>
  </section>
</BaseLayout>
