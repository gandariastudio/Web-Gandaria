---
import { CLOUDINARY_CLOUD_NAME } from 'astro:env/server';
import type { CmsImage } from '@/lib/db/schema';
import { imagePosition, imageSrc, imageSrcset, zoomRegion } from '@/lib/cms/cloudinary';

interface Props {
  image: CmsImage;
  /** Candidate widths for srcset (Cloudinary images only). */
  widths?: number[];
  sizes?: string;
  class?: string;
  loading?: 'eager' | 'lazy';
  alt?: string;
  /** data-* attributes are passed through to the <img>. */
  [attr: `data-${string}`]: string | boolean | undefined;
}

const { image, widths = [640, 1280, 1920], sizes = '100vw', class: className, loading = 'lazy', alt, ...data } = Astro.props;
// Framing chosen in the admin's Adjust dialog: Cloudinary serves the zoomed region and
// object-position keeps the chosen point in view (frames crop with CSS object-cover).
const region = CLOUDINARY_CLOUD_NAME && image.publicId ? zoomRegion(image) : undefined;
const sourceWidth = region?.width ?? image.width;
const sourceHeight = region?.height ?? image.height;
const src = imageSrc(image, CLOUDINARY_CLOUD_NAME, Math.min(Math.max(...widths), sourceWidth));
const srcset = imageSrcset(image, CLOUDINARY_CLOUD_NAME, widths);
const position = imagePosition(image);
---

<img
  src={src}
  srcset={srcset}
  sizes={srcset ? sizes : undefined}
  width={sourceWidth}
  height={sourceHeight}
  alt={alt ?? image.alt}
  loading={loading}
  fetchpriority={loading === 'eager' ? 'high' : undefined}
  decoding="async"
  class={className}
  style={position ? `object-position:${position}` : undefined}
  {...data}
/>
