---
import CmsImage from '@/components/ui/CmsImage.astro';
import type { ProjectRow } from '@/lib/db/schema';

interface Props {
  project: ProjectRow;
}

const { project } = Astro.props;
const p = project;
---

<!--
  The cover keeps its 4:3 upload shape (like Dribbble) so nothing is cropped. Below 1200px the card
  is too small to carry the caption over the image, so the caption sits under it instead. The
  caption is one column so a long services list wraps instead of squeezing the title.
-->
<a href={`/work/${project.slug}`} class="relative flex w-full flex-col gap-4 lg:block" data-project-card>
  <div class="project-media relative aspect-[4/3] w-full overflow-hidden rounded-[10px] bg-[#f3f3f5]" data-cursor-zone-target data-img-reveal>
    <div class="absolute inset-0" data-parallax-img>
      <CmsImage image={p.cover} widths={[700, 1100, 1400]} sizes="(min-width: 810px) 50vw, 100vw" class="size-full object-cover" />
    </div>
    <div class="pointer-events-none absolute inset-0 hidden bg-[linear-gradient(#0000_45%,#000000b8_100%)] lg:block"></div>
  </div>
  <div class="pointer-events-none flex flex-col items-start gap-3 px-1 lg:absolute lg:inset-x-0 lg:bottom-0 lg:px-6 lg:pb-6 lg:text-paper xl:px-7 xl:pb-7">
    <p class="type-label flex flex-wrap items-center gap-1.5 text-muted lg:text-paper/70">
      <span>{p.sector}</span><span>·</span><span>{p.year}</span>
    </p>
    <h3 class="type-h3 max-w-[560px] [text-wrap:balance]">{p.title}</h3>
    <p class="type-small line-clamp-3 max-w-[460px] text-muted [text-wrap:pretty] lg:text-paper/78">{p.summary}</p>
    <p class="type-label line-clamp-2 max-w-[560px] lg:text-paper/90">{p.services}</p>
  </div>
</a>
