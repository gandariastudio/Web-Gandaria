---
import CmsImage from '@/components/ui/CmsImage.astro';
import type { ProjectRow } from '@/lib/db/schema';

interface Props {
  project: ProjectRow;
}

const { project } = Astro.props;
const p = project;
---

<!--
  The cover keeps its 16:9 upload shape so nothing is cropped. Below 1200px the card is too short
  to carry the caption over the image, so the caption sits under it instead.
-->
<a href={`/work/${project.slug}`} class="relative flex w-full flex-col gap-4 lg:block" data-project-card>
  <div class="project-media relative aspect-[16/9] w-full overflow-hidden rounded-[10px] bg-[#f3f3f5]" data-cursor-zone-target data-img-reveal>
    <div class="absolute inset-0" data-parallax-img>
      <CmsImage image={p.cover} widths={[700, 1100, 1400]} sizes="(min-width: 810px) 50vw, 100vw" class="size-full object-cover" />
    </div>
    <div class="pointer-events-none absolute inset-0 hidden bg-[linear-gradient(#0000_40%,#000000ad_100%)] lg:block"></div>
  </div>
  <div
    class="pointer-events-none flex flex-col items-start gap-3 px-1 lg:absolute lg:inset-x-0 lg:bottom-0 lg:px-5 lg:pb-5 lg:text-paper xl:flex-row xl:items-end xl:gap-8 xl:px-7 xl:pb-7">
    <div class="flex flex-1 flex-col gap-2">
      <h3 class="type-h3">{p.title}</h3>
      <p class="type-small max-w-[420px] text-muted [text-wrap:pretty] lg:text-paper/78">{p.summary}</p>
    </div>
    <div class="type-label flex w-max shrink-0 flex-col items-start gap-1.5 xl:items-end">
      <p class="flex items-center gap-1.5 text-muted lg:text-paper/70">
        <span>{p.sector}</span><span>·</span><span>{p.year}</span>
      </p>
      <p class="whitespace-nowrap">{p.services}</p>
    </div>
  </div>
</a>
