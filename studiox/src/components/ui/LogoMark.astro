---
import { cn } from '@/utils/cn';
import { MARK_RECTS } from '@/data/site';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg class={cn('overflow-visible', className)} viewBox="0 0 24 24" aria-hidden="true" data-mark>
  {
    MARK_RECTS.map(([x, y, w, h, origin]) => (
      <rect x={x} y={y} width={w} height={h} fill="currentColor" style={`transform-origin:${origin};transform-box:fill-box`} />
    ))
  }
</svg>
