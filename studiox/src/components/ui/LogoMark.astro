---
import { cn } from '@/utils/cn';
import { MARK_PATHS } from '@/data/site';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<!-- The Gandaria mark: ring, smile and dot. Fills follow currentColor; scripts/site.ts animates the parts. -->
<svg class={cn('overflow-visible', className)} viewBox="0 0 829 1005" aria-hidden="true" data-mark>
  <path class="mark-ring" d={MARK_PATHS.ring} fill="currentColor" fill-rule="evenodd" />
  <path class="mark-smile" d={MARK_PATHS.smile} fill="currentColor" />
  <circle class="mark-dot" cx={MARK_PATHS.dot.cx} cy={MARK_PATHS.dot.cy} r={MARK_PATHS.dot.r} fill="currentColor" />
</svg>

<style>
  [data-mark] path,
  [data-mark] circle {
    transform-box: fill-box;
    transform-origin: 50% 50%;
  }
</style>
