---
interface Props {
  tag: string;
  meta: string;
  lines: [string, string];
  intro?: string;
  wide?: boolean;
}

const { tag, meta, lines, intro, wide = false } = Astro.props;
const fx = { 'data-text-reveal': 'line', 'data-tr-blur': '8', 'data-tr-y': '28' };
---

<section
  class:list={[
    'bg-fog px-5 pt-[120px] pb-16 md:px-8 md:pt-36 md:pb-[88px]',
    wide ? 'lg:px-10 lg:pt-[168px] lg:pb-28' : 'xl:px-10 xl:pt-[168px] xl:pb-28',
  ]}
  data-cursor="Scroll">
  <div class="mx-auto flex max-w-[1600px] flex-col gap-12">
    <div class="flex items-center justify-between line-b pb-5">
      <p class="tag">{tag}</p>
      <p class="type-label text-muted">{meta}</p>
    </div>
    <h1 class="type-display flex flex-col">
      <span class="block" {...fx} data-tr-stagger="0.05">{lines[0]}</span>
      <span class="block text-cobalt" {...fx} data-tr-stagger="0.15">{lines[1]}</span>
    </h1>
    {
      intro && (
        <div class="flex flex-col gap-6 md:flex-row md:gap-10" data-reveal>
          <div class="min-h-[100px] flex-1 max-md:hidden" />
          <p class:list={['type-h4 text-muted md:flex-1', wide ? 'lg:w-[560px] lg:flex-none' : 'xl:w-[560px] xl:flex-none']}>{intro}</p>
        </div>
      )
    }
  </div>
</section>
