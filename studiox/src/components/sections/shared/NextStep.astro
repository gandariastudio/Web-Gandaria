---
import Button from '@/components/ui/Button.astro';

interface Props {
  wide?: boolean;
}

const { wide = false } = Astro.props;
---

<section
  class:list={[
    'bg-cobalt-deep px-5 py-[88px] text-paper md:px-8 md:py-28',
    wide ? 'lg:px-10 lg:py-[140px]' : 'xl:px-10 xl:py-[140px]',
  ]}
  data-cursor="Say hello">
  <div class="mx-auto flex max-w-[1600px] flex-col gap-10">
    <p class="tag">Next step</p>
    <h2 class="next-title flex flex-col">
      <span class="block" data-text-reveal="line" data-tr-blur="8" data-tr-y="28" data-tr-stagger="0.05">Have a project</span>
      <span class="block text-sky" data-text-reveal="line" data-tr-blur="8" data-tr-y="28" data-tr-stagger="0.15">in mind?</span>
    </h2>
    <div class="flex flex-col items-start gap-6 md:flex-row md:items-center md:gap-8">
      <Button label="Start a project" href="/contact" variant="light" />
    </div>
  </div>
</section>

<style>
  .next-title {
    font-size: 52px;
    line-height: 0.92;
    letter-spacing: -0.06em;
  }
  @media (width >= 810px) {
    .next-title {
      font-size: 88px;
    }
  }
  @media (width >= 1440px) {
    .next-title {
      font-size: 120px;
    }
  }
</style>
