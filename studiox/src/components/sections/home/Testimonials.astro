---
import BigTitle from '@/components/ui/BigTitle.astro';
import { getDb } from '@/lib/db';
import { listTestimonials } from '@/lib/db/queries';

const testimonials = await listTestimonials(await getDb());

const cards: typeof testimonials = [];
while (testimonials.length && cards.length < 10) cards.push(...testimonials);
const tilt = (i: number) => {
  const t = 2 + ((i * 37) % 31) / 10;
  return i % 2 === 0 ? -t : t;
};
const mark = 'M0 24V14.4C0 6.6 3.9 1.8 11.4 0l1.3 3C8.6 4.5 6.6 7.4 6.4 11.4H12V24H0Zm16 0V14.4C16 6.6 19.9 1.8 27.4 0l1.3 3c-4.1 1.5-6.1 4.4-6.3 8.4H28V24H16Z';
---

<section class="overflow-clip bg-fog pt-24 pb-[72px] md:pt-[120px] md:pb-24 xl:pt-40 xl:pb-[120px]" data-cursor="Drag" data-cursor-zone="[data-deck]">
  <div class="flex flex-col items-center gap-12 xl:gap-4">
    <div class="flex w-full flex-col items-center gap-5 px-5 md:gap-6 md:px-8 xl:gap-7 xl:px-10">
      <p class="tag">Voices</p>
      <BigTitle lines={['In their', 'own words.']} />
    </div>
    <div class="qd-root relative h-[440px] w-full overflow-hidden md:h-[540px] xl:h-[620px]" role="region" aria-label="Client testimonials" data-deck>
      {
        cards.map((c, i) => {
          const tone = i % 3;
          const zig = i % 2 === 0 ? 'calc(var(--qd-zig) * -1)' : 'var(--qd-zig)';
          return (
            <div
              class="qd-card"
              aria-hidden={i >= testimonials.length ? 'true' : undefined}
              style={`margin-top:${zig};z-index:${i};transform:translate3d(calc(var(--qd-w) * ${0.75 * i}),0,0) rotate(${tilt(i)}deg)`}
              data-tilt={tilt(i)}
              data-qd-card>
              <div class:list={['qd-inner', tone === 0 && 'bg-fog', tone === 1 && 'bg-fog', tone === 2 && 'bg-cobalt text-paper']} style={`transition-delay:${(i % 5) * 0.08}s`}>
                <svg class="qd-mark top-[var(--qd-mt)] left-[var(--qd-ml)]" viewBox="0 0 28 24" aria-hidden="true">
                  <path fill={tone === 2 ? '#fff' : 'var(--color-cobalt)'} d={mark} />
                </svg>
                <svg class="qd-mark right-[var(--qd-ml)] bottom-[var(--qd-mt)] rotate-180" viewBox="0 0 28 24" aria-hidden="true">
                  <path fill={tone === 2 ? '#fff' : 'var(--color-cobalt)'} d={mark} />
                </svg>
                <p class="qd-quote">{c.quote}</p>
                <div class="flex flex-col items-center gap-1">
                  <span class="text-[15px] leading-[1.3] font-semibold tracking-[-0.005em]">{c.name}</span>
                  <span class:list={['text-[13px] leading-[1.3] tracking-[0.01em]', tone === 2 ? 'text-paper/68' : 'text-muted']}>{c.role}</span>
                </div>
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .qd-root {
    --qd-w: 280px;
    --qd-zig: 56px;
    --qd-pad: 52px 26px 52px;
    --qd-q: 16px;
    --qd-mark: 16px;
    --qd-mt: 20px;
    --qd-ml: 20px;
    cursor: grab;
    touch-action: pan-y;
    user-select: none;
    isolation: isolate;
  }
  @media (width >= 810px) {
    .qd-root {
      --qd-w: 360px;
      --qd-zig: 80px;
      --qd-pad: 64px 38px 64px;
      --qd-q: 19px;
      --qd-mark: 20px;
      --qd-mt: 24px;
      --qd-ml: 24px;
    }
  }
  @media (width >= 1200px) {
    .qd-root {
      --qd-w: 420px;
      --qd-zig: 110px;
      --qd-pad: 76px 48px 76px;
      --qd-q: 22px;
      --qd-mark: 24px;
      --qd-mt: 28px;
      --qd-ml: 28px;
    }
  }
  .qd-root[data-dragging] {
    cursor: grabbing;
  }
  .qd-card {
    position: absolute;
    left: calc(50% - var(--qd-w) * 2);
    top: 50%;
    width: var(--qd-w);
    translate: 0 -50%;
    will-change: transform;
  }
  .qd-inner {
    position: relative;
    padding: var(--qd-pad);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    text-align: center;
    box-shadow: inset 0 0 0 1px var(--color-line);
    transition:
      opacity 0.9s var(--ease-expo),
      transform 1.2s var(--ease-expo);
  }
  .qd-inner.bg-cobalt {
    box-shadow: none;
  }
  .qd-root[data-ready]:not([data-seen]) .qd-inner {
    opacity: 0;
    transform: translate3d(0, 64px, 0);
  }
  .qd-quote {
    margin: 0;
    font-size: var(--qd-q);
    line-height: 1.38;
    letter-spacing: -0.012em;
    text-wrap: pretty;
  }
  .qd-mark {
    position: absolute;
    height: var(--qd-mark);
    width: auto;
  }
</style>
