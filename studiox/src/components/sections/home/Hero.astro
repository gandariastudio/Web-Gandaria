---
import KineticWordmark from '@/components/ui/KineticWordmark.astro';
import Button from '@/components/ui/Button.astro';
import { heroMeta } from '@/data/home';
---

<section class="relative bg-fog" data-cursor="Scroll">
  <div class="container-x mx-auto flex max-w-[1680px] flex-col gap-7 bg-fog pt-[88px] pb-10 md:min-h-screen md:pt-24 md:pb-12 xl:pt-[108px] xl:pb-16">
    <div class="type-label grid grid-cols-2 gap-x-4 line-b pb-4 md:grid-cols-3 md:gap-x-10">
      {
        [...heroMeta, `Semarang & remote — booking ${Astro.locals.settings.bookingFrom}`].map((text, i) => (
          <p class:list={['hero-meta', i === 1 && 'max-md:hidden', i === 2 && 'text-right']} data-hero-meta={i}>
            {text}
          </p>
        ))
      }
    </div>

    <div class="hero-mask relative isolate pb-3">
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <div class="hero-blob absolute left-1/2" data-blob></div>
      </div>
      <div class="relative mix-blend-multiply">
        <KineticWordmark text="Gandaria" tag="h1" color="var(--color-cobalt)" />
      </div>
    </div>

    <div class="min-h-6 flex-1 max-md:hidden" aria-hidden="true"></div>

    <div class="flex flex-col gap-7 max-md:pt-6 xl:flex-row xl:items-end xl:justify-between xl:gap-10">
      <p class="type-h1 [text-wrap:balance] xl:w-[880px] xl:shrink-0" data-reveal data-reveal-amount="0.15">
        <span class="block" data-text-reveal="line" data-tr-blur="10" data-tr-y="28" data-tr-stagger="0.05">
          We build brands, websites and content for businesses that have outgrown how they look.
        </span>
      </p>
      <div class="flex flex-col gap-6 md:w-[520px] xl:w-[440px]">
        <p class="type-body text-muted">
          A small senior team of strategists, designers and developers in Semarang, working with businesses across Indonesia.
        </p>
        <div class="flex flex-wrap items-center gap-6">
          <Button label="Start a project" href="/#contact" />
          <a href="/#work" class="text-link type-small">See selected work</a>
        </div>
      </div>
    </div>
  </div>

  <div class="relative h-[70vh] md:h-[80vh] xl:h-screen" data-cursor-dark data-expand>
    <div class="absolute inset-0 overflow-hidden" data-expand-frame>
      <div class="absolute inset-0 origin-center" data-expand-media>
        <video class="absolute inset-0 size-full object-cover" src="/videos/hero.mp4" autoplay muted loop playsinline preload="auto"></video>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-blob {
    top: calc(50% - 6px);
    width: 96%;
    height: 170px;
    translate: -50% -50%;
  }
  @media (width >= 810px) {
    .hero-blob {
      top: 50px;
      width: 72%;
      height: 320px;
      translate: -50% 0;
    }
  }
  @media (width >= 1440px) {
    .hero-blob {
      top: 70px;
      width: 52%;
      height: 460px;
    }
  }
  .js .hero-meta {
    opacity: 0.001;
  }
</style>
