---
import LogoMark from '@/components/ui/LogoMark.astro';
import Button from '@/components/ui/Button.astro';
import { NAV_LINKS } from '@/data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const section = '/' + (path.split('/')[1] ?? '');
const EMAIL = Astro.locals.settings.email;
const [emailUser, emailDomain] = EMAIL.split('@');
---

<header class="pointer-events-none fixed inset-x-0 top-0 z-50" data-header>
  <div class="flex items-start px-4 pt-3.5 md:px-6 md:pt-4 xl:px-10 xl:pt-5">
    <div class="header-slot pointer-events-auto flex h-[52px] flex-1 items-center" data-logo-slot>
      <a href="/" class="flex items-center gap-2.5" aria-label="Gandaria Studio home" data-logo>
        <span class="logo-mark relative size-6 text-ink" data-logo-mark><LogoMark class="size-6" /></span>
        <span class="logo-word text-[20px] leading-none font-medium tracking-[-0.04em] text-ink">Gandaria</span>
      </a>
    </div>

    <nav
      class="menu pointer-events-auto relative w-[168px] shrink-0 overflow-clip rounded-[4px] bg-paper md:w-[300px] xl:w-[340px]"
      aria-label="Main"
      data-menu>
      <button
        type="button"
        class="menu__bar flex h-[52px] w-full cursor-pointer items-center justify-between px-[18px]"
        aria-expanded="false"
        aria-controls="menu-panel"
        data-menu-toggle>
        <span class="menu__label type-small relative h-[21px] text-left" data-menu-label>
          <span class="menu__label-closed">Menu</span>
          <span class="menu__label-open">Close</span>
        </span>
        <span class="menu__burger relative h-[7px] w-5" aria-hidden="true">
          <span class="menu__line menu__line--top" data-line-top></span>
          <span class="menu__line menu__line--bottom" data-line-bottom></span>
        </span>
      </button>
      <div id="menu-panel" class="menu__panel flex flex-col gap-7 px-[18px] py-5" data-menu-panel>
        <ul class="menu__links flex flex-col gap-1" data-menu-links>
          {
            NAV_LINKS.map((link) => (
              <li>
                <a href={link.href} class="type-h3 block" aria-current={section === link.href ? 'page' : undefined}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
        <div class="menu__contact type-label flex flex-wrap items-center justify-between gap-x-4 gap-y-1 line-t pt-3.5" data-menu-contact>
          <a href={`mailto:${EMAIL}`} class="md:whitespace-nowrap">{emailUser}@<wbr />{emailDomain}</a>
          <p class="whitespace-nowrap text-muted">Semarang — Remote</p>
        </div>
      </div>
    </nav>

    <div class="header-slot pointer-events-auto hidden h-[52px] flex-1 justify-end md:flex" data-cta-slot>
      <Button label="Let’s talk" href="/#contact" class="header-cta" />
    </div>
  </div>
</header>

<style>
  .menu {
    height: 52px;
    box-shadow:
      inset 0 0 0 1px rgba(37, 35, 32, 0.07),
      0 1px 2px rgba(37, 35, 32, 0.04),
      0 18px 40px -18px rgba(37, 35, 32, 0.18);
    transform-origin: 50% 0;
    transition:
      scale 0.9s var(--ease-swift),
      translate 0.9s var(--ease-swift);
  }
  @media (max-width: 809.98px) {
    .menu {
      transform-origin: 100% 0;
    }
  }
  .menu.is-open {
    height: auto;
    animation: nav-open 0.7s var(--ease-expo) backwards;
  }

  .menu__label > span {
    display: block;
    transition: opacity 0.4s ease;
  }
  .menu__label-open {
    position: absolute;
    inset: 0;
    opacity: 0;
  }
  .menu.is-open .menu__label-closed {
    opacity: 0;
  }
  .menu.is-open .menu__label-open {
    opacity: 1;
  }

  .menu__line {
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--color-ink);
    transition:
      scale 0.55s var(--ease-expo),
      transform 0.5s var(--ease-expo),
      top 0.5s var(--ease-expo),
      bottom 0.5s var(--ease-expo);
  }
  .menu__line--top {
    top: 0;
    transform-origin: 100% 50%;
  }
  .menu__line--bottom {
    bottom: 0;
    transform-origin: 0 50%;
  }
  .menu.is-open .menu__line--top {
    top: 3px;
    transform: rotate(45deg);
    transform-origin: 50% 50%;
  }
  .menu.is-open .menu__line--bottom {
    bottom: 3px;
    transform: rotate(-45deg);
    transform-origin: 50% 50%;
  }

  @media (hover: hover) {
    .menu:not(.is-open) .menu__bar:hover .menu__line {
      scale: 0.55 1;
    }
    .menu__links a {
      transition:
        color 0.35s ease,
        opacity 0.35s ease,
        translate 0.5s var(--ease-expo);
    }
    .menu__links:hover a {
      opacity: 0.35;
    }
    .menu__links a:hover,
    .menu__links a[aria-current='page'] {
      opacity: 1;
    }
    .menu__links a:hover {
      translate: 6px 0;
      color: var(--color-cobalt);
    }
  }

  .menu__links a[aria-current='page'] {
    color: var(--color-cobalt);
  }

  .menu.is-open .menu__links > li {
    animation: nav-item 0.6s var(--ease-expo) backwards;
  }
  .menu.is-open .menu__links > li:nth-child(1) {
    animation-delay: 0.08s;
  }
  .menu.is-open .menu__links > li:nth-child(2) {
    animation-delay: 0.12s;
  }
  .menu.is-open .menu__links > li:nth-child(3) {
    animation-delay: 0.16s;
  }
  .menu.is-open .menu__links > li:nth-child(4) {
    animation-delay: 0.2s;
  }
  .menu.is-open .menu__links > li:nth-child(5) {
    animation-delay: 0.24s;
  }
  .menu.is-open .menu__links > li:nth-child(6) {
    animation-delay: 0.28s;
  }
  .menu.is-open .menu__contact {
    animation: nav-item 0.6s var(--ease-expo) 0.32s backwards;
  }

  @keyframes nav-open {
    from {
      clip-path: inset(0 0 calc(100% - 52px) 0 round 4px);
    }
    to {
      clip-path: inset(0 0 0 0 round 4px);
    }
  }
  @keyframes nav-item {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  .header-slot {
    transition:
      translate 0.9s var(--ease-swift),
      opacity 0.7s var(--ease-swift);
  }
  [data-cta-slot] {
    transition-delay: 0.06s;
  }
  :global(html.is-scrolled) .header-slot {
    translate: 0 -150%;
    opacity: 0;
    pointer-events: none;
  }
  :global(html.is-scrolled) .menu:not(.is-open) {
    scale: 0.86;
    translate: 0 -6px;
  }

  .logo-mark,
  .logo-word {
    transition: color 0.6s var(--ease-swift);
  }
  :global(html.logo-dark) .logo-mark,
  :global(html.logo-dark) .logo-word {
    color: #fff;
  }
  :global(.header-cta) {
    box-shadow:
      0 1px 2px rgba(12, 56, 141, 0.18),
      0 14px 30px -14px rgba(12, 56, 141, 0.45) !important;
    transition: background-color 0.6s var(--ease-swift) !important;
  }
  :global(html.cta-dark .header-cta) {
    background-color: #fff !important;
    color: var(--color-ink) !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .menu,
    .menu * {
      animation: none !important;
    }
  }
</style>
