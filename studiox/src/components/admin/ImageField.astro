---
import { CLOUDINARY_API_KEY, CLOUDINARY_API_SECRET, CLOUDINARY_CLOUD_NAME } from 'astro:env/server';
import Icon from './Icon.astro';
import type { CmsImage } from '@/lib/db/schema';
import { cloudinaryUrl, imageSrc } from '@/lib/cms/cloudinary';
import { frameLayout, isDefaultCrop, normalizeCrop, parseAspect } from '@/lib/cms/crop';

interface Props {
  name: string;
  label: string;
  value?: Partial<CmsImage> | null;
  /** Cloudinary folder under gandaria/, e.g. "projects". */
  folder: string;
  errors?: Record<string, string>;
  /** e.g. "2400 × 1350" */
  recommended?: string;
  hint?: string;
  /** Show the image without cropping (logos). */
  contain?: boolean;
  /**
   * Preview URL of a built-in image used while this slot is empty. Makes the field optional and
   * adds a "Use built-in image" button that clears the upload.
   */
  fallback?: string;
}

const { name, label, value, folder, errors = {}, recommended, hint, contain = false, fallback } = Astro.props;
const ready = !!(CLOUDINARY_CLOUD_NAME && CLOUDINARY_API_KEY && CLOUDINARY_API_SECRET);
const crop = value?.crop && !isDefaultCrop(value.crop) ? normalizeCrop(value.crop) : null;
const source =
  value && (value.publicId || value.url)
    ? { publicId: value.publicId ?? null, url: value.url ?? null, width: value.width, height: value.height, ...(crop ? { crop } : {}) }
    : null;
// The field shows the whole original laid out in the slot's frame shape, so the preview matches
// the website; the Adjust dialog moves and zooms it (logos are shown whole and cannot be adjusted).
const [aspectW, aspectH] = parseAspect(recommended);
const adjustable = !contain && !!source?.width && !!source?.height;
const zoomable = !!(source?.publicId && CLOUDINARY_CLOUD_NAME);
const original = source
  ? source.publicId && CLOUDINARY_CLOUD_NAME
    ? cloudinaryUrl(CLOUDINARY_CLOUD_NAME, source.publicId, 1600)
    : (source.url ?? '')
  : '';
const uploaded = source ? (adjustable ? original : imageSrc({ ...source, width: source.width ?? 0, height: source.height ?? 0, alt: '' }, CLOUDINARY_CLOUD_NAME, 960)) : '';
const preview = uploaded || fallback || '';
const layout = adjustable ? frameLayout(source!.width!, source!.height!, zoomable ? crop : crop && { ...crop, zoom: 1 }, aspectW, aspectH) : null;
const layoutStyle = layout ? `left:${layout.left}%;top:${layout.top}%;width:${layout.width}%;height:${layout.height}%` : undefined;
const usingBuiltIn = !uploaded && !!fallback;
const imageError = errors[`${name}.width`] ?? errors[`${name}.height`] ?? errors[name];
const altError = errors[`${name}.alt`];
const id = `f-${name.replace(/[^a-z0-9]+/gi, '-')}`;
---

<div
  class:list={['a-field', (imageError || altError) && 'has-error']}
  data-image-field
  data-folder={folder}
  data-fallback={fallback}
  data-aspect={contain ? undefined : `${aspectW}x${aspectH}`}
  data-original={adjustable ? original : undefined}
  data-zoomable={zoomable ? 'true' : undefined}
  style={contain ? undefined : `--frame:${aspectW} / ${aspectH}`}>
  <span class="a-label">{label}</span>
  <label class:list={['a-drop', !ready && 'is-off', preview && 'has-image', contain && 'is-contain']} data-drop>
    <input type="file" accept="image/*" class="sr-only" data-image-file disabled={!ready} />
    <span class="a-drop-preview" data-preview-box>{preview && <img src={preview} alt="" data-preview style={layoutStyle} class:list={[layout && 'is-placed']} />}</span>
    <span class="a-drop-cta">
      <span class="a-drop-icon"><Icon name={preview ? 'image' : 'upload'} size={18} /></span>
      <span class="a-drop-text" data-drop-text>
        {ready ? (preview ? 'Drop a new image or click to replace' : 'Drop an image here or click to upload') : 'Upload is off until Cloudinary is connected'}
      </span>
      <span class="a-hint" data-image-status>
        {usingBuiltIn ? 'Built-in image · ' : ''}{source?.width ? `Current ${source.width} × ${source.height}` : ''}{recommended ? `${source?.width ? ' · ' : ''}Recommended ${recommended}` : ''}
      </span>
    </span>
    <span class="a-drop-progress" aria-hidden="true"><span data-progress></span></span>
  </label>
  <input type="hidden" name={name} value={source ? JSON.stringify(source) : ''} data-image-value />
  {
    !contain && (
      <div class="a-image-actions">
        <button type="button" class="a-btn a-btn--ghost a-btn--sm" data-image-adjust hidden={!adjustable}>
          <Icon name="image" size={15} />
          Adjust
        </button>
        {fallback && (
          <button type="button" class="a-btn a-btn--ghost a-btn--sm" data-image-reset hidden={usingBuiltIn}>
            Use built-in image
          </button>
        )}
      </div>
    )
  }
  {
    !contain && (
      <dialog class="a-crop" data-crop-dialog aria-label={`Adjust ${label.toLowerCase()}`}>
        <div class="a-crop-head">
          <h2 class="a-crop-title">Adjust image</h2>
          <button type="button" class="a-icon-btn" data-crop-cancel aria-label="Close">
            <Icon name="close" size={18} />
          </button>
        </div>
        <div class="a-crop-frame" data-crop-frame>
          <img alt="" draggable="false" data-crop-img />
        </div>
        <p class="a-hint">Drag the image to choose what shows in the frame. The frame has the same shape as on the website.</p>
        <label class="a-crop-zoom">
          <span class="a-label">Zoom</span>
          <input type="range" min="1" max="4" step="0.01" value="1" data-crop-zoom />
        </label>
        <p class="a-hint" data-crop-zoom-note hidden>Zoom works once you upload your own image.</p>
        <div class="a-crop-foot">
          <button type="button" class="a-btn a-btn--ghost a-btn--sm" data-crop-reset>Reset</button>
          <span class="a-crop-spacer" />
          <button type="button" class="a-btn a-btn--ghost" data-crop-cancel>Cancel</button>
          <button type="button" class="a-btn" data-crop-apply>Apply</button>
        </div>
      </dialog>
    )
  }
  {hint && <p class="a-hint">{hint}</p>}
  {imageError && <p class="a-error">{imageError}</p>}
  <label class="a-label a-label--spaced" for={`${id}-alt`}>Describe the image {!fallback && <span class="a-req">*</span>}</label>
  <input id={`${id}-alt`} name={`${name}_alt`} value={value?.alt ?? ''} class="a-input" placeholder={fallback ? 'Needed when you upload an image. Read aloud by screen readers.' : 'What does the image show? Read aloud by screen readers.'} data-image-alt />
  {altError && <p class="a-error">{altError}</p>}
</div>

<style>
  .a-image-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 8px;
  }
  .a-image-actions:not(:has(button:not([hidden]))) {
    display: none;
  }
  .a-drop {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1.5px dashed var(--a-line-strong);
    border-radius: 0;
    background: var(--a-softer);
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      background-color 0.15s ease;
  }
  .a-drop:hover,
  .a-drop.is-over {
    border-color: var(--a-text);
    background: var(--a-soft);
  }
  .a-drop.is-off {
    cursor: not-allowed;
  }
  .a-drop:has(input:focus-visible) {
    outline: 2px solid var(--a-text);
    outline-offset: 2px;
  }
  .a-drop-preview {
    display: none;
  }
  .a-drop.has-image .a-drop-preview {
    position: relative;
    display: block;
    overflow: hidden;
    height: 240px;
    background: var(--a-soft);
  }
  /* Photo slots preview in the frame's shape (e.g. 16:9), like the website. */
  .a-field[data-aspect] .a-drop.has-image .a-drop-preview {
    height: auto;
    aspect-ratio: var(--frame);
  }
  .a-drop-preview :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Placed by frameLayout(): the whole original, positioned and sized in % of the frame. */
  .a-drop-preview :global(img.is-placed),
  .a-crop-frame img {
    position: absolute;
    max-width: none;
    object-fit: fill;
  }
  .a-drop.is-contain .a-drop-preview :global(img) {
    object-fit: contain;
    padding: 24px;
  }
  .a-drop-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 28px 20px;
    text-align: center;
  }
  .a-drop.has-image .a-drop-cta {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px 10px;
    padding: 12px 16px;
    border-top: 1px solid var(--a-line);
    background: var(--a-bg);
  }
  .a-drop-icon {
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border-radius: 0;
    background: var(--a-bg);
    box-shadow: inset 0 0 0 1px var(--a-line);
  }
  .a-drop.has-image .a-drop-icon {
    width: 28px;
    height: 28px;
  }
  .a-drop-text {
    font-size: 14px;
    font-weight: 500;
  }
  /* Adjust dialog */
  .a-crop {
    width: min(720px, calc(100vw - 32px));
    max-height: calc(100vh - 32px);
    margin: auto;
    border: 1px solid var(--a-line);
    padding: 22px;
    background: var(--a-bg);
    color: var(--a-text);
  }
  .a-crop[open] {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .a-crop::backdrop {
    background: rgb(37 35 32 / 0.55);
  }
  .a-crop-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .a-crop-title {
    font-size: 22px;
    font-weight: 400;
    letter-spacing: -0.03em;
  }
  .a-crop-frame {
    position: relative;
    overflow: hidden;
    width: 100%;
    max-height: 60vh;
    aspect-ratio: var(--frame);
    margin-inline: auto;
    background: var(--a-soft);
    cursor: grab;
    touch-action: none;
    user-select: none;
  }
  .a-crop-frame.is-dragging {
    cursor: grabbing;
  }
  .a-crop-frame::after {
    content: '';
    position: absolute;
    inset: 0;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.6);
    pointer-events: none;
  }
  .a-crop-zoom {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .a-crop-zoom input {
    flex: 1;
    accent-color: var(--a-accent);
  }
  .a-crop-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
  .a-crop-spacer {
    flex: 1;
  }
  .a-drop-progress {
    position: absolute;
    inset: auto 0 0 0;
    height: 3px;
  }
  .a-drop-progress span {
    display: block;
    width: 0;
    height: 100%;
    background: var(--a-text);
    transition: width 0.2s ease;
  }
</style>
