---
interface Props {
  name: string;
  label: string;
  value?: string;
  error?: string;
}

const { name, label, value = '', error } = Astro.props;
const tools = [
  ['h2', 'Heading', 'H2'],
  ['h3', 'Subheading', 'H3'],
  ['bold', 'Bold', 'B'],
  ['italic', 'Italic', 'I'],
  ['link', 'Link', 'Link'],
  ['bullet', 'Bulleted list', '• List'],
  ['ordered', 'Numbered list', '1. List'],
  ['quote', 'Quote', '“ Quote'],
  ['undo', 'Undo', '↶'],
  ['redo', 'Redo', '↷'],
];
---

<div class:list={['a-field', error && 'has-error']} data-rich-text>
  <span class="a-label">{label}</span>
  <div class="rt">
    <div class="rt-bar" role="toolbar" aria-label="Formatting">
      {tools.map(([cmd, title, text]) => <button type="button" class="rt-btn" data-cmd={cmd} title={title} aria-label={title}>{text}</button>)}
    </div>
    <div class="rt-editor article-body" data-editor></div>
  </div>
  <input type="hidden" name={name} value={value} data-rich-value />
  <noscript><p class="a-hint">The editor needs JavaScript.</p></noscript>
  {error && <p class="a-error">{error}</p>}
</div>

<style>
  .rt {
    border: 1px solid var(--a-line-strong);
    border-radius: 0;
    background: var(--a-bg);
  }
  .rt:focus-within {
    border-color: var(--a-text);
    box-shadow: 0 0 0 3px rgb(0 0 0 / 0.06);
  }
  .has-error .rt {
    border-color: var(--a-danger);
  }
  .rt-bar {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    border-bottom: 1px solid var(--a-line);
    border-radius: 0;
    background: var(--a-bg);
    padding: 8px;
  }
  .rt-btn {
    height: 30px;
    border-radius: 0;
    padding: 0 11px;
    font-size: 13px;
    color: var(--a-muted);
    cursor: pointer;
  }
  .rt-btn:hover {
    background: var(--a-soft);
    color: var(--a-text);
  }
  .rt-btn.is-active {
    background: var(--a-text);
    color: #fff;
  }
  .rt-editor {
    min-height: 320px;
    padding: 20px 22px;
    font-size: 16px !important;
  }
  .rt-editor :global(.ProseMirror) {
    min-height: 300px;
    outline: none;
  }
  .rt-editor :global(.ProseMirror > * + *) {
    margin-top: 0.8em;
  }
  .rt-editor :global(ul) {
    list-style: disc;
    padding-left: 1.4em;
  }
  .rt-editor :global(ol) {
    list-style: decimal;
    padding-left: 1.4em;
  }
  .rt-editor :global(blockquote) {
    border-left: 3px solid var(--a-line-strong);
    padding-left: 1em;
    color: var(--a-muted);
  }
  .rt-editor :global(a) {
    text-decoration: underline;
  }
  .rt-editor :global(h3) {
    font-size: 22px;
  }
</style>
