---
import Icon from './Icon.astro';

interface Props {
  /** List page that handles intent=delete, e.g. /admin/projects */
  action: string;
  id: number;
  noun: string;
  /** What deleting means; defaults to the wording for website content. */
  message?: string;
}

const { action, id, noun, message = 'It disappears from the website right away. This cannot be undone.' } = Astro.props;
---

<section class="a-danger">
  <div>
    <h2>Delete this {noun}</h2>
    <p>{message}</p>
  </div>
  <form method="post" action={action} class="a-danger-actions">
    <input type="hidden" name="id" value={id} />
    <input type="hidden" name="intent" value="delete" />
    <button type="button" class="a-btn a-btn--danger" data-countdown-delete data-label={`Delete ${noun}`}>
      <Icon name="trash" size={16} />
      <span data-countdown-text>Delete {noun}</span>
    </button>
    <button type="button" class="a-btn a-btn--ghost" data-countdown-cancel hidden>Cancel</button>
  </form>
</section>
